taset path — it may vary by which Kaggle OULAD dataset you added\n    candidates = glob.glob('/kaggle/input/**/studentVle.csv', recursive=True)\n    if candidates:\n        DATA_DIR = os.path.dirname(candidates[0])\n        print(f'Found OULAD at: {DATA_DIR}')\n    else:\n        print('⚠️  studentVle.csv not found. Add the OULAD dataset via Add Data.')\n        DATA_DIR = '/kaggle/input/oulad'  # fallback — adjust if needed\nelse:\n    print('Not on Kaggle — skip this cell, run Option B below.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:26:58.535619Z","iopub.execute_input":"2026-04-16T22:26:58.536601Z","iopub.status.idle":"2026-04-16T22:26:58.545717Z","shell.execute_reply.started":"2026-04-16T22:26:58.536560Z","shell.execute_reply":"2026-04-16T22:26:58.544900Z"}},"outputs":[{"name":"stdout","text":"Found OULAD at: /kaggle/input/datasets/anlgrbz/student-demographics-online-education-dataoulad\n","output_type":"stream"}],"execution_count":7},{"id":"load-data-colab","cell_type":"code","source":"# ── OPTION B: Google Colab — mount Drive ────────────────────────────────────\n# Upload your OULAD CSVs to a folder in Google Drive first.\n# Then set DATA_DIR to the path of that folder.\n\n\"\"\"if ON_COLAB:\n    from google.colab import drive\n    drive.mount('/content/drive')\n\n    # ⬇️  EDIT THIS PATH to point to your OULAD folder in Drive\n    DATA_DIR = '/content/drive/MyDrive/OULAD'\n\n    print(f'DATA_DIR set to: {DATA_DIR}')\n    print('Files found:', os.listdir(DATA_DIR) if os.path.exists(DATA_DIR) else '⚠️ path not found')\nelse:\n    print('Not on Colab — skip this cell.')\n    \"\"\"","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:26:58.546711Z","iopub.execute_input":"2026-04-16T22:26:58.546945Z","iopub.status.idle":"2026-04-16T22:26:58.568103Z","shell.execute_reply.started":"2026-04-16T22:26:58.546920Z","shell.execute_reply":"2026-04-16T22:26:58.567222Z"}},"outputs":[{"execution_count":8,"output_type":"execute_result","data":{"text/plain":"\"if ON_COLAB:\\n    from google.colab import drive\\n    drive.mount('/content/drive')\\n\\n    # ⬇️  EDIT THIS PATH to point to your OULAD folder in Drive\\n    DATA_DIR = '/content/drive/MyDrive/OULAD'\\n\\n    print(f'DATA_DIR set to: {DATA_DIR}')\\n    print('Files found:', os.listdir(DATA_DIR) if os.path.exists(DATA_DIR) else '⚠️ path not found')\\nelse:\\n    print('Not on Colab — skip this cell.')\\n    \""},"metadata":{}}],"execution_count":8},{"id":"verify-files","cell_type":"code","source":"# Verify the three required files exist\nrequired = ['studentVle.csv', 'vle.csv', 'studentAssessment.csv']\nfor f in required:\n    path = os.path.join(DATA_DIR, f)\n    exists = os.path.exists(path)\n    size_mb = os.path.getsize(path) / 1e6 if exists else 0\n    status = f'✅ {size_mb:.1f} MB' if exists else '❌ MISSING'\n    print(f'{f:30s} {status}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:26:58.570412Z","iopub.execute_input":"2026-04-16T22:26:58.570739Z","iopub.status.idle":"2026-04-16T22:26:58.584870Z","shell.execute_reply.started":"2026-04-16T22:26:58.570712Z","shell.execute_reply":"2026-04-16T22:26:58.584043Z"}},"outputs":[{"name":"stdout","text":"studentVle.csv                 ✅ 453.8 MB\nvle.csv                        ✅ 0.3 MB\nstudentAssessment.csv          ✅ 5.7 MB\n","output_type":"stream"}],"execution_count":9},{"id":"sec3","cell_type":"markdown","source":"## 3. OULAD Preprocessing\n\n**What we're building:** `(student_id, skill_id, correct, timestamp)` interaction sequences.\n\n**The join logic:**\n- `vle.csv` maps `id_site → activity_type` (the \"skill\" proxy)\n- `studentVle.csv` has `(student, id_site, date, sum_click)` — VLE engagement events\n- `studentAssessment.csv` has `(student, assessment, score)` — actual correctness signal\n\n**Correctness encoding:**  \nSince VLE interactions don't have binary correct/incorrect labels, we derive correctness from **assessment scores** joined via `code_module + code_presentation`. For each student, VLE interactions are labelled with their assessment performance in that module (score ≥ 50 = correct). This is the standard approach in OULAD-based KT research.","metadata":{}},{"id":"preprocess","cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nprint('Loading raw OULAD files...')\n\n# Load files\nvle          = pd.read_csv(os.path.join(DATA_DIR, 'vle.csv'))\nstudent_vle  = pd.read_csv(os.path.join(DATA_DIR, 'studentVle.csv'))\nstudent_ass  = pd.read_csv(os.path.join(DATA_DIR, 'studentAssessment.csv'))\n\nprint(f'vle            : {vle.shape}')\nprint(f'studentVle     : {student_vle.shape}')\nprint(f'studentAssessment: {student_ass.shape}')\nprint()\nprint('Columns:')\nprint(' vle           :', vle.columns.tolist())\nprint(' studentVle    :', student_vle.columns.tolist())\nprint(' studentAssess :', student_ass.columns.tolist())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:26:58.585894Z","iopub.execute_input":"2026-04-16T22:26:58.586664Z","iopub.status.idle":"2026-04-16T22:27:09.997378Z","shell.execute_reply.started":"2026-04-16T22:26:58.586637Z","shell.execute_reply":"2026-04-16T22:27:09.996583Z"}},"outputs":[{"name":"stdout","text":"Loading raw OULAD files...\nvle            : (6364, 6)\nstudentVle     : (10655280, 6)\nstudentAssessment: (173912, 5)\n\nColumns:\n vle           : ['id_site', 'code_module', 'code_presentation', 'activity_type', 'week_from', 'week_to']\n studentVle    : ['code_module', 'code_presentation', 'id_student', 'id_site', 'date', 'sum_click']\n studentAssess : ['id_assessment', 'id_student', 'date_submitted', 'is_banked', 'score']\n","output_type":"stream"}],"execution_count":10},{"id":"build-skill-map","cell_type":"code","source":"# ── Step 1: Build skill encoder from real vle.csv ──────────────────────────\n# Map each id_site → skill_id (integer) using activity_type as the skill label\n\n# Encode activity_type as integer skill_id\nvle_clean = vle[['id_site', 'activity_type']].drop_duplicates(subset='id_site').copy()\n\n# Assign a compact integer skill_id per unique id_site\nvle_clean = vle_clean.reset_index(drop=True)\nvle_clean['skill_id'] = vle_clean.index\n\nNUM_SKILLS = len(vle_clean)\nprint(f'Unique VLE resources (skills): {NUM_SKILLS}')\nprint(f'Activity type distribution:')\nprint(vle_clean['activity_type'].value_counts().to_string())\n\n# Save real skill_encoder — replaces the synthetic skill_encoder_v2.csv\nskill_encoder = vle_clean[['id_site', 'skill_id', 'activity_type']]\nskill_encoder.to_csv('skill_encoder_real.csv', index=False)\nprint(f'\\nSaved skill_encoder_real.csv ({len(skill_encoder)} rows)')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:09.998362Z","iopub.execute_input":"2026-04-16T22:27:09.998981Z","iopub.status.idle":"2026-04-16T22:27:10.038874Z","shell.execute_reply.started":"2026-04-16T22:27:09.998953Z","shell.execute_reply":"2026-04-16T22:27:10.038334Z"}},"outputs":[{"name":"stdout","text":"Unique VLE resources (skills): 6364\nActivity type distribution:\nactivity_type\nresource          2660\nsubpage           1055\noucontent          996\nurl                886\nforumng            194\nquiz               127\npage               102\noucollaborate       82\nquestionnaire       61\nouwiki              49\ndataplus            28\nexternalquiz        26\nhomepage            22\nglossary            21\nouelluminate        21\ndualpane            20\nrepeatactivity       5\nhtmlactivity         4\nsharedsubpage        3\nfolder               2\n\nSaved skill_encoder_real.csv (6364 rows)\n","output_type":"stream"}],"execution_count":11},{"id":"build-correctness","cell_type":"code","source":"# ── Step 2: Build per-student correctness labels from assessments ──────────\n# Strategy: a student's correctness for a module = 1 if their mean score >= 50\n\n# Clean assessment scores\nass = student_ass.copy()\nass['score'] = pd.to_numeric(ass['score'], errors='coerce')\nass = ass.dropna(subset=['score'])\n\n# Per-student module-level correctness (mean score >= 50 threshold)\n# We join on id_student to get a general correctness label\nstudent_correct = (\n    ass.groupby('id_student')['score']\n    .mean()\n    .reset_index()\n    .rename(columns={'score': 'mean_score'})\n)\nstudent_correct['correct'] = (student_correct['mean_score'] >= 50).astype(int)\n\nprint(f'Students with assessment data: {len(student_correct)}')\nprint(f'Correct rate: {student_correct[\"correct\"].mean():.3f}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:10.039707Z","iopub.execute_input":"2026-04-16T22:27:10.040012Z","iopub.status.idle":"2026-04-16T22:27:10.072061Z","shell.execute_reply.started":"2026-04-16T22:27:10.039988Z","shell.execute_reply":"2026-04-16T22:27:10.071366Z"}},"outputs":[{"name":"stdout","text":"Students with assessment data: 23351\nCorrect rate: 0.922\n","output_type":"stream"}],"execution_count":12},{"id":"build-interactions","cell_type":"code","source":"# ── Step 3: Join studentVle + skill map + correctness labels ───────────────\n\nprint('Joining datasets...')\n\n# Join VLE events with skill encoder to get skill_id\ninteractions = student_vle.merge(\n    vle_clean[['id_site', 'skill_id']], on='id_site', how='inner'\n)\n\n# Join with student correctness labels\ninteractions = interactions.merge(\n    student_correct[['id_student', 'correct']], on='id_student', how='inner'\n)\n\n# Use 'date' as timestamp for ordering interactions\ninteractions = interactions.rename(columns={'id_student': 'student_id', 'date': 'timestamp'})\ninteractions = interactions[['student_id', 'skill_id', 'correct', 'timestamp']]\n\n# Sort by student then time\ninteractions = interactions.sort_values(['student_id', 'timestamp']).reset_index(drop=True)\n\nprint(f'Total interactions: {len(interactions):,}')\nprint(f'Unique students   : {interactions[\"student_id\"].nunique():,}')\nprint(f'Unique skills     : {interactions[\"skill_id\"].nunique():,}')\nprint(f'Correct rate      : {interactions[\"correct\"].mean():.3f}')\nprint()\nprint(interactions.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:10.073062Z","iopub.execute_input":"2026-04-16T22:27:10.073454Z","iopub.status.idle":"2026-04-16T22:27:15.584638Z","shell.execute_reply.started":"2026-04-16T22:27:10.073429Z","shell.execute_reply":"2026-04-16T22:27:15.583869Z"}},"outputs":[{"name":"stdout","text":"Joining datasets...\nTotal interactions: 10,563,593\nUnique students   : 23,326\nUnique skills     : 6,253\nCorrect rate      : 0.965\n\n   student_id  skill_id  correct  timestamp\n0        6516       247        1        -23\n1        6516       374        1        -23\n2        6516       391        1        -23\n3        6516       388        1        -23\n4        6516       412        1        -23\n","output_type":"stream"}],"execution_count":13},{"id":"save-interactions","cell_type":"code","source":"# Save the processed interactions CSV\ninteractions.to_csv('oulad_interactions.csv', index=False)\nprint(f'Saved oulad_interactions.csv — {len(interactions):,} rows')\n\n# Sequence length stats\nseq_lens = interactions.groupby('student_id').size()\nprint(f'\\nSequence length stats:')\nprint(f'  mean   : {seq_lens.mean():.1f}')\nprint(f'  median : {seq_lens.median():.1f}')\nprint(f'  min    : {seq_lens.min()}')\nprint(f'  max    : {seq_lens.max()}')\nprint(f'  >= 5   : {(seq_lens >= 5).sum()} students (usable)')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:15.585633Z","iopub.execute_input":"2026-04-16T22:27:15.586425Z","iopub.status.idle":"2026-04-16T22:27:29.649037Z","shell.execute_reply.started":"2026-04-16T22:27:15.586395Z","shell.execute_reply":"2026-04-16T22:27:29.648028Z"}},"outputs":[{"name":"stdout","text":"Saved oulad_interactions.csv — 10,563,593 rows\n\nSequence length stats:\n  mean   : 452.9\n  median : 315.0\n  min    : 1\n  max    : 6389\n  >= 5   : 23272 students (usable)\n","output_type":"stream"}],"execution_count":14},{"id":"sec4","cell_type":"markdown","source":"## 4. Model Definitions\n\nPasting the model classes directly so the notebook is self-contained (no PLRS package install needed).","metadata":{}},{"id":"model-sakt","cell_type":"code","source":"# ── SAKTModel (vanilla baseline) ────────────────────────────────────────────\nimport math\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nclass SAKTModel(nn.Module):\n    \"\"\"Vanilla SAKT — used as baseline for AUC comparison.\"\"\"\n\n    def __init__(self, num_skills, embed_dim=64, num_heads=8, dropout=0.2, max_seq_len=100):\n        super().__init__()\n        self.num_skills  = num_skills\n        self.embed_dim   = embed_dim\n        self.max_seq_len = max_seq_len\n\n        self.interaction_embed = nn.Embedding(2 * num_skills + 2, embed_dim, padding_idx=0)\n        self.pos_embed         = nn.Embedding(max_seq_len, embed_dim)\n        self.self_attn = nn.MultiheadAttention(embed_dim, num_heads, dropout=dropout, batch_first=True)\n        self.layer_norm1 = nn.LayerNorm(embed_dim)\n        self.layer_norm2 = nn.LayerNorm(embed_dim)\n        self.ffn = nn.Sequential(\n            nn.Linear(embed_dim, embed_dim * 2), nn.ReLU(),\n            nn.Dropout(dropout), nn.Linear(embed_dim * 2, embed_dim),\n        )\n        self.skill_embed  = nn.Embedding(num_skills + 1, embed_dim, padding_idx=0)\n        self.output_layer = nn.Linear(embed_dim * 2, 1)\n        self.dropout      = nn.Dropout(dropout)\n\n    def forward(self, interactions, target_skills, mask):\n        B, L = interactions.shape\n        positions = torch.arange(L, device=interactions.device).unsqueeze(0)\n        x = self.dropout(self.interaction_embed(interactions) + self.pos_embed(positions))\n\n        causal_mask     = torch.triu(torch.ones(L, L, device=x.device, dtype=torch.bool), diagonal=1)\n        key_padding_mask = ~mask\n\n        x_attn, _ = self.self_attn(x, x, x, attn_mask=causal_mask, key_padding_mask=key_padding_mask)\n        x_attn = torch.nan_to_num(x_attn, nan=0.0)\n        x = self.layer_norm1(x + x_attn)\n        x = self.layer_norm2(x + self.ffn(x))\n\n        out = self.output_layer(torch.cat([x, self.skill_embed(target_skills)], dim=-1)).squeeze(-1)\n        return out\n\n    def save(self, path, config=None):\n        torch.save({'state_dict': self.state_dict(), 'model_type': 'SAKTModel',\n                    'config': config or {'num_skills': self.num_skills, 'embed_dim': self.embed_dim,\n                                         'max_seq_len': self.max_seq_len}}, path)\n\nprint('SAKTModel defined ✅')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:29.652777Z","iopub.execute_input":"2026-04-16T22:27:29.653241Z","iopub.status.idle":"2026-04-16T22:27:29.671641Z","shell.execute_reply.started":"2026-04-16T22:27:29.653108Z","shell.execute_reply":"2026-04-16T22:27:29.670683Z"}},"outputs":[{"name":"stdout","text":"SAKTModel defined ✅\n","output_type":"stream"}],"execution_count":15},{"id":"model-sakt-decay","cell_type":"code","source":"# ── SAKTWithDecay (Ebbinghaus forgetting curve) ──────────────────────────────\n\nclass DecayAttention(nn.Module):\n    \"\"\"\n    Multi-head attention with Ebbinghaus forgetting curve decay.\n    Decay penalty: rate_h * log(1 + |i - j|) — learned per head.\n    \"\"\"\n    def __init__(self, embed_dim, num_heads, dropout=0.2, decay_init=1.0):\n        super().__init__()\n        self.embed_dim = embed_dim\n        self.num_heads = num_heads\n        self.head_dim  = embed_dim // num_heads\n        assert embed_dim % num_heads == 0\n\n        self.q_proj   = nn.Linear(embed_dim, embed_dim)\n        self.k_proj   = nn.Linear(embed_dim, embed_dim)\n        self.v_proj   = nn.Linear(embed_dim, embed_dim)\n        self.out_proj = nn.Linear(embed_dim, embed_dim)\n        self.dropout  = nn.Dropout(dropout)\n\n        # Learned decay rate per head — constrained positive via softplus\n        self.decay_logit = nn.Parameter(\n            torch.full((num_heads,), math.log(math.exp(decay_init) - 1))\n        )\n\n    def forward(self, x, causal_mask, key_padding_mask):\n        B, L, D = x.shape\n        H, Hd   = self.num_heads, self.head_dim\n\n        Q = self.q_proj(x).view(B, L, H, Hd).transpose(1, 2)\n        K = self.k_proj(x).view(B, L, H, Hd).transpose(1, 2)\n        V = self.v_proj(x).view(B, L, H, Hd).transpose(1, 2)\n\n        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(Hd)\n\n        # Ebbinghaus decay: penalise distant past interactions\n        positions = torch.arange(L, device=x.device)\n        dist = (positions.unsqueeze(0) - positions.unsqueeze(1)).abs().float()\n        decay_rate    = F.softplus(self.decay_logit)           # (H,)\n        decay_penalty = decay_rate.view(H, 1, 1) * torch.log1p(dist).unsqueeze(0)\n        scores = scores - decay_penalty.unsqueeze(0)\n\n        scores = scores.masked_fill(causal_mask.unsqueeze(0).unsqueeze(0), -1e9)\n        if key_padding_mask is not None:\n            scores = scores.masked_fill(key_padding_mask.unsqueeze(1).unsqueeze(2), -1e9)\n\n        attn = self.dropout(F.softmax(scores, dim=-1))\n        out  = torch.matmul(attn, V).transpose(1, 2).contiguous().view(B, L, D)\n        return self.out_proj(out)\n\n\nclass SAKTWithDecay(nn.Module):\n    \"\"\"SAKT + Ebbinghaus Forgetting Curve Decay — drop-in upgrade.\"\"\"\n\n    def __init__(self, num_skills, embed_dim=64, num_heads=8, dropout=0.2,\n                 max_seq_len=100, decay_init=1.0):\n        super().__init__()\n        self.num_skills  = num_skills\n        self.embed_dim   = embed_dim\n        self.max_seq_len = max_seq_len\n\n        self.interaction_embed = nn.Embedding(2 * num_skills + 2, embed_dim, padding_idx=0)\n        self.pos_embed         = nn.Embedding(max_seq_len, embed_dim)\n        self.decay_attn        = DecayAttention(embed_dim, num_heads, dropout, decay_init)\n        self.layer_norm1 = nn.LayerNorm(embed_dim)\n        self.layer_norm2 = nn.LayerNorm(embed_dim)\n        self.ffn = nn.Sequential(\n            nn.Linear(embed_dim, embed_dim * 2), nn.ReLU(),\n            nn.Dropout(dropout), nn.Linear(embed_dim * 2, embed_dim),\n        )\n        self.skill_embed  = nn.Embedding(num_skills + 1, embed_dim, padding_idx=0)\n        self.output_layer = nn.Linear(embed_dim * 2, 1)\n        self.dropout      = nn.Dropout(dropout)\n\n    def forward(self, interactions, target_skills, mask):\n        B, L = interactions.shape\n        positions = torch.arange(L, device=interactions.device).unsqueeze(0)\n        x = self.dropout(self.interaction_embed(interactions) + self.pos_embed(positions))\n\n        causal_mask      = torch.triu(torch.ones(L, L, device=x.device, dtype=torch.bool), diagonal=1)\n        key_padding_mask = ~mask\n\n        x = self.layer_norm1(x + self.decay_attn(x, causal_mask, key_padding_mask))\n        x = self.layer_norm2(x + self.ffn(x))\n        out = self.output_layer(torch.cat([x, self.skill_embed(target_skills)], dim=-1)).squeeze(-1)\n        return out\n\n    def save(self, path, config=None):\n        torch.save({\n            'state_dict': self.state_dict(),\n            'model_type': 'SAKTWithDecay',\n            'config': config or {\n                'num_skills':  self.num_skills,\n                'embed_dim':   self.embed_dim,\n                'num_heads':   self.decay_attn.num_heads,\n                'max_seq_len': self.max_seq_len,\n                'model_type':  'SAKTWithDecay',\n            }\n        }, path)\n\n    @classmethod\n    def load(cls, path, device='cpu'):\n        payload = torch.load(path, map_location=device, weights_only=False)\n        cfg = payload['config']\n        model = cls(num_skills=cfg['num_skills'], embed_dim=cfg.get('embed_dim', 64),\n                    num_heads=cfg.get('num_heads', 8), dropout=cfg.get('dropout', 0.2),\n                    max_seq_len=cfg.get('max_seq_len', 100), decay_init=cfg.get('decay_init', 1.0))\n        model.load_state_dict(payload['state_dict'])\n        return model.to(device).eval()\n\nprint('SAKTWithDecay defined ✅')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:29.672845Z","iopub.execute_input":"2026-04-16T22:27:29.673370Z","iopub.status.idle":"2026-04-16T22:27:29.697791Z","shell.execute_reply.started":"2026-04-16T22:27:29.673335Z","shell.execute_reply":"2026-04-16T22:27:29.696763Z"}},"outputs":[{"name":"stdout","text":"SAKTWithDecay defined ✅\n","output_type":"stream"}],"execution_count":16},{"id":"sec5","cell_type":"markdown","source":"## 5. Dataset & Training Infrastructure","metadata":{}},{"id":"dataset","cell_type":"code","source":"from torch.utils.data import Dataset, DataLoader\nfrom sklearn.metrics import roc_auc_score\nimport time\n\n\nclass KTDataset(Dataset):\n    def __init__(self, sequences, max_seq_len=100, n_skills=5736):\n        self.max_seq_len = max_seq_len\n        self.n_skills    = n_skills\n        self.samples     = []\n        for skill_seq, correct_seq in sequences:\n            for start in range(0, max(1, len(skill_seq) - 1), max_seq_len // 2):\n                s = skill_seq[start : start + max_seq_len + 1]\n                c = correct_seq[start : start + max_seq_len + 1]\n                if len(s) >= 2:\n                    self.samples.append((s, c))\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        skill_seq, correct_seq = self.samples[idx]\n        if len(skill_seq) > self.max_seq_len + 1:\n            skill_seq   = skill_seq[-self.max_seq_len - 1:]\n            correct_seq = correct_seq[-self.max_seq_len - 1:]\n\n        interactions   = [s + c * self.n_skills + 1 for s, c in zip(skill_seq[:-1], correct_seq[:-1])]\n        target_skills  = skill_seq[1:]\n        target_correct = correct_seq[1:]\n        seq_len = len(interactions)\n        pad_len = self.max_seq_len - seq_len\n\n        return {\n            'interactions':   torch.LongTensor([0] * pad_len + interactions),\n            'target_skills':  torch.LongTensor([0] * pad_len + target_skills),\n            'target_correct': torch.FloatTensor([0] * pad_len + target_correct),\n            'mask':           torch.BoolTensor([False] * pad_len + [True] * seq_len),\n        }\n\n\ndef collate_fn(batch):\n    return {k: torch.stack([b[k] for b in batch]) for k in batch[0]}\n\n\ndef load_sequences(csv_path, min_seq_len=5):\n    df = pd.read_csv(csv_path).sort_values(['student_id', 'timestamp'])\n    sequences = []\n    for _, grp in df.groupby('student_id'):\n        skills   = grp['skill_id'].astype(int).tolist()\n        corrects = grp['correct'].astype(int).tolist()\n        if len(skills) >= min_seq_len:\n            sequences.append((skills, corrects))\n    print(f'Loaded {len(sequences)} student sequences')\n    return sequences\n\n\nprint('Dataset utilities defined ✅')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:29.698976Z","iopub.execute_input":"2026-04-16T22:27:29.700579Z","iopub.status.idle":"2026-04-16T22:27:30.710308Z","shell.execute_reply.started":"2026-04-16T22:27:29.700544Z","shell.execute_reply":"2026-04-16T22:27:30.709515Z"}},"outputs":[{"name":"stdout","text":"Dataset utilities defined ✅\n","output_type":"stream"}],"execution_count":17},{"id":"train-fn","cell_type":"code","source":"def train_model(model, sequences, num_skills, config, model_name='model'):\n    \"\"\"\n    Full training loop with early stopping.\n    Returns: (best_val_auc, checkpoint_path, history)\n    \"\"\"\n    np.random.seed(42)\n    idx    = np.random.permutation(len(sequences))\n    n_val  = max(1, int(len(sequences) * config['val_split']))\n    val_seq   = [sequences[i] for i in idx[:n_val]]\n    train_seq = [sequences[i] for i in idx[n_val:]]\n\n    print(f'  Train: {len(train_seq)} students | Val: {len(val_seq)} students')\n\n    max_seq_len = config.get('max_seq_len', 100)\n    train_ds = KTDataset(train_seq, max_seq_len, num_skills)\n    val_ds   = KTDataset(val_seq,   max_seq_len, num_skills)\n    train_loader = DataLoader(train_ds, batch_size=config['batch_size'],\n                              shuffle=True,  collate_fn=collate_fn, num_workers=2)\n    val_loader   = DataLoader(val_ds,   batch_size=config['batch_size'] * 2,\n                              shuffle=False, collate_fn=collate_fn, num_workers=2)\n\n    device    = torch.device(DEVICE)\n    model     = model.to(device)\n    optimizer = torch.optim.Adam(model.parameters(), lr=config['lr'],\n                                 weight_decay=config['weight_decay'])\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode='max', patience=2, factor=0.5\n    )\n    criterion = nn.BCEWithLogitsLoss()\n\n    # NaN gradient guard (for vanilla SAKT MHA padding edge case)\n    for p in model.parameters():\n        p.register_hook(lambda g: torch.nan_to_num(g, nan=0.0))\n\n    best_auc      = 0.0\n    patience_ctr  = 0\n    checkpoint    = f'{model_name}_best.pt'\n    history       = []\n\n    print(f'  Params: {sum(p.numel() for p in model.parameters()):,}')\n    print(f'  {\"Epoch\":>6} {\"Train Loss\":>11} {\"Val Loss\":>9} {\"Val AUC\":>9} {\"Val Acc\":>9} {\"Time\":>7}')\n    print('  ' + '-' * 56)\n\n    for epoch in range(1, config['epochs'] + 1):\n        t0 = time.time()\n\n        # ── Train ────────────────────────────────────────────────────\n        model.train()\n        total_loss = 0.0\n        for batch in train_loader:\n            interactions   = batch['interactions'].to(device)\n            target_skills  = batch['target_skills'].to(device)\n            target_correct = batch['target_correct'].to(device)\n            mask           = batch['mask'].to(device)\n\n            optimizer.zero_grad()\n            logits = model(interactions, target_skills, mask)\n            loss   = criterion(logits[mask], target_correct[mask])\n            loss.backward()\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            optimizer.step()\n            total_loss += loss.item()\n        train_loss = total_loss / max(len(train_loader), 1)\n\n        # ── Validate ─────────────────────────────────────────────────\n        model.eval()\n        val_loss_total = 0.0\n        all_probs, all_labels = [], []\n        with torch.no_grad():\n            for batch in val_loader:\n                interactions   = batch['interactions'].to(device)\n                target_skills  = batch['target_skills'].to(device)\n                target_correct = batch['target_correct'].to(device)\n                mask           = batch['mask'].to(device)\n\n                logits      = model(interactions, target_skills, mask)\n                real_logits = logits[mask]\n                real_labels = target_correct[mask]\n\n                val_loss_total += criterion(real_logits, real_labels).item()\n                all_probs.extend(torch.sigmoid(real_logits).cpu().numpy().tolist())\n                all_labels.extend(real_labels.cpu().numpy().tolist())\n\n        val_loss = val_loss_total / max(len(val_loader), 1)\n        probs_arr  = np.nan_to_num(np.array(all_probs),  nan=0.5)\n        labels_arr = np.nan_to_num(np.array(all_labels), nan=0.0)\n        val_auc = float(roc_auc_score(labels_arr, probs_arr)) \\\n                  if len(np.unique(labels_arr)) > 1 else 0.5\n        val_acc = float(((probs_arr >= 0.5) == labels_arr).mean())\n\n        scheduler.step(val_auc)\n        elapsed = time.time() - t0\n\n        history.append({'epoch': epoch, 'train_loss': train_loss,\n                        'val_loss': val_loss, 'val_auc': val_auc, 'val_acc': val_acc})\n\n        print(f'  {epoch:>6} {train_loss:>11.4f} {val_loss:>9.4f} '\n              f'{val_auc:>9.4f} {val_acc:>9.4f} {elapsed:>6.1f}s')\n\n        if val_auc > best_auc + 1e-4:\n            best_auc = val_auc\n            patience_ctr = 0\n            model.save(checkpoint, config={'num_skills': num_skills,\n                                           'embed_dim': config['embed_dim'],\n                                           'num_heads': config['num_heads'],\n                                           'dropout': config['dropout'],\n                                           'max_seq_len': max_seq_len,\n                                           'model_type': model_name})\n            print(f'         ✅ New best AUC: {best_auc:.4f} → {checkpoint}')\n        else:\n            patience_ctr += 1\n            if patience_ctr >= config['patience']:\n                print(f'\\n  Early stopping at epoch {epoch}')\n                break\n\n    print(f'\\n  Best val AUC: {best_auc:.4f}')\n    return best_auc, checkpoint, history\n\n\nprint('Training loop defined ✅')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T22:27:30.711456Z","iopub.execute_input":"2026-04-16T22:27:30.711952Z","iopub.status.idle":"2026-04-16T22:27:30.730427Z","shell.execute_reply.started":"2026-04-16T22:27:30.711919Z","shell.execute_reply":"2026-04-16T22:27:30.729541Z"}},"outputs":[{"name":"stdout","text":"Training loop defined ✅\n","output_type":"stream"}],"execution_count":18},{"id":"sec6","cell_type":"markdown","source":"## 6. Training Config & Data Split","metadata":{}},{"id":"config","cell_type":"code","source":"# ── Training hyperparameters ─────────────────────────────────────────────────\n# These match the PLRS repo defaults. Tune embed_dim/num_heads if you want.\n\nCONFIG = {\n    'embed_dim':    64,\n    'num_heads':    8,\n    'dropout':      0.2,\n    'max_seq_len':  100,\n    'decay_init':   1.0,    # initial Ebbinghaus decay rate (learned during training)\n    'epochs':       50,\n    'batch_size':   64,\n    'lr':           1e-3,\n    'weight_decay': 1e-5,\n    'val_split':    0.1,\n    'patience':     5,\n}\n\nprint('Config:')\nfor k, v in CONFIG.items():\n    print(f'  {k:<15