# ── PLRS Environment Variables ────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
#   cp .env.example .env

# ── Database (required for Docker / production) ───────────────────────────────
POSTGRES_DB=plrs
POSTGRES_USER=plrs
POSTGRES_PASSWORD=change_me_in_production   # REQUIRED — change before deploying

# Constructed automatically in docker-compose.yml — set manually for external DB:
# PLRS_DB_URL=postgresql://plrs:your_password@your-host:5432/plrs

# ── Redis (required for Docker / production) ──────────────────────────────────
REDIS_PASSWORD=                              # leave empty to disable Redis auth (dev only)

# Constructed automatically in docker-compose.yml — set manually for external Redis:
# PLRS_REDIS_URL=redis://:your_password@your-host:6379/0

# ── API configuration ─────────────────────────────────────────────────────────
API_PORT=8000                                # host port to bind (default: 8000)
WORKERS=2                                    # uvicorn worker processes

# Dev mode: set to 1 to bypass API key auth (local development only)
PLRS_DEV_MODE=0

# ── LLM providers (set whichever you use) ─────────────────────────────────────
ANTHROPIC_API_KEY=                           # Claude — get from console.anthropic.com
OPENAI_API_KEY=                              # OpenAI — get from platform.openai.com
HF_TOKEN=                                    # HuggingFace — get from huggingface.co/settings/tokens

# Ollama — defaults to http://localhost:11434
# Set this if Ollama runs on a different host/port:
# OLLAMA_HOST=http://your-ollama-server:11434

# ── Optional: persist API keys to file (overridden by DB in production) ───────
# PLRS_KEYS_PATH=/path/to/plrs_keys.json
