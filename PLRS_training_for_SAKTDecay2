    "# ── Step 2: Clean assessment scores ────────────────────────────────────────\n",
    "\n",
    "ass = student_ass.copy()\n",
    "ass['score'] = pd.to_numeric(ass['score'], errors='coerce')\n",
    "ass = ass.dropna(subset=['score'])\n",
    "\n",
    "# OULAD is heavily right-skewed (median score ~80).\n",
    "# Using the standard 50 threshold gives 91%+ correct rate — too imbalanced for KT.\n",
    "# We use the dataset median as threshold to get a balanced binary task.\n",
    "# This is consistent with several OULAD KT papers (e.g. Mbouzao et al. 2020).\n",
    "SCORE_THRESHOLD = ass['score'].median()\n",
    "print(f'Score median (used as threshold): {SCORE_THRESHOLD}')\n",
    "\n",
    "ass['correct'] = (ass['score'] >= SCORE_THRESHOLD).astype(int)\n",
    "\n",
    "print(f'Assessment attempts (non-withdrawn): {len(ass):,}')\n",
    "print(f'Correct rate (target ~0.50): {ass[\"correct\"].mean():.3f}')\n",
    "print(f'Score distribution:')\n",
    "print(ass['score'].describe())\n",
    "print(f'\\nCorrect value counts:')\n",
    "print(ass['correct'].value_counts())\n"
   ]
