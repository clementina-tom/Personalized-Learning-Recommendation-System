    "# ── Step 2: Build interaction-level correctness (time-aware, no leakage) ──\n",
    "#\n",
    "# For each student × VLE interaction, find the nearest upcoming assessment\n",
    "# in the same (code_module, code_presentation) and use that score.\n",
    "# correct = 1 if score >= 50.\n",
    "#\n",
    "# This prevents leakage: the label for each interaction is only derived\n",
    "# from assessments that happen AFTER the interaction date.\n",
    "\n",
    "# 1. Join assessments metadata → get assessment date per id_assessment\n",
    "ass_meta = assessments[['id_assessment', 'code_module', 'code_presentation', 'date']].copy()\n",
    "ass_meta = ass_meta.rename(columns={'date': 'assessment_date'})\n",
    "ass_meta['assessment_date'] = pd.to_numeric(ass_meta['assessment_date'], errors='coerce')\n",
    "\n",
    "# 2. Join student scores with assessment metadata\n",
    "student_ass_clean = student_ass.copy()\n",
    "student_ass_clean['score'] = pd.to_numeric(student_ass_clean['score'], errors='coerce')\n",
    "student_ass_clean = student_ass_clean.dropna(subset=['score'])\n",
    "\n",
    "ass_with_meta = student_ass_clean.merge(ass_meta, on='id_assessment', how='inner')\n",
    "ass_with_meta['correct'] = (ass_with_meta['score'] >= 50).astype(int)\n",
    "\n",
    "print(f'Assessment events with metadata: {len(ass_with_meta):,}')\n",
    "print(f'Correct rate in assessments: {ass_with_meta[\"correct\"].mean():.3f}')\n",
    "print(ass_with_meta[['id_student', 'code_module', 'code_presentation',\n",
    "                      'assessment_date', 'score', 'correct']].head())\n"
   ]
