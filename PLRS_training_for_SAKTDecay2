    "# ── Step 1: Build skill encoder from real vle.csv ──────────────────────────\n",
    "# Map each id_site → skill_id (integer) using activity_type as the skill label\n",
    "\n",
    "# Encode activity_type as integer skill_id\n",
    "vle_clean = vle[['id_site', 'activity_type']].drop_duplicates(subset='id_site').copy()\n",
    "\n",
    "# Assign a compact integer skill_id per unique id_site\n",
    "vle_clean = vle_clean.reset_index(drop=True)\n",
    "vle_clean['skill_id'] = vle_clean.index\n",
    "\n",
    "NUM_SKILLS = len(vle_clean)\n",
    "print(f'Unique VLE resources (skills): {NUM_SKILLS}')\n",
    "print(f'Activity type distribution:')\n",
    "print(vle_clean['activity_type'].value_counts().to_string())\n",
    "\n",
    "# Save real skill_encoder — replaces the synthetic skill_encoder_v2.csv\n",
    "skill_encoder = vle_clean[['id_site', 'skill_id', 'activity_type']]\n",
    "skill_encoder.to_csv('skill_encoder_real.csv', index=False)\n",
    "print(f'\\nSaved skill_encoder_real.csv ({len(skill_encoder)} rows)')"
