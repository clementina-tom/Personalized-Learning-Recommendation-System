ores\n\n**Correctness encoding (no leakage):**  \nEach VLE interaction is assigned the score from the **nearest upcoming assessment** in the same module/presentation. `correct = 1 if score >= 50`. This is a time-aware, interaction-level label — not a global student average.\n","metadata":{}},{"id":"preprocess","cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\nprint('Loading raw OULAD files...')\n\nvle         = pd.read_csv(os.path.join(DATA_DIR, 'vle.csv'))\nstudent_vle = pd.read_csv(os.path.join(DATA_DIR, 'studentVle.csv'))\nstudent_ass = pd.read_csv(os.path.join(DATA_DIR, 'studentAssessment.csv'))\nassessments = pd.read_csv(os.path.join(DATA_DIR, 'assessments.csv'))\n\nprint(f'vle              : {vle.shape}')\nprint(f'studentVle       : {student_vle.shape}')\nprint(f'studentAssessment: {student_ass.shape}')\nprint(f'assessments      : {assessments.shape}')\nprint()\nprint('Columns:')\nprint(' vle          :', vle.columns.tolist())\nprint(' studentVle   :', student_vle.columns.tolist())\nprint(' studentAssess:', student_ass.columns.tolist())\nprint(' assessments  :', assessments.columns.tolist())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:57:32.714443Z","iopub.execute_input":"2026-04-16T23:57:32.714865Z","iopub.status.idle":"2026-04-16T23:57:38.636796Z","shell.execute_reply.started":"2026-04-16T23:57:32.714821Z","shell.execute_reply":"2026-04-16T23:57:38.635549Z"}},"outputs":[{"name":"stdout","text":"Loading raw OULAD files...\nvle              : (6364, 6)\nstudentVle       : (10655280, 6)\nstudentAssessment: (173912, 5)\nassessments      : (206, 6)\n\nColumns:\n vle          : ['id_site', 'code_module', 'code_presentation', 'activity_type', 'week_from', 'week_to']\n studentVle   : ['code_module', 'code_presentation', 'id_student', 'id_site', 'date', 'sum_click']\n studentAssess: ['id_assessment', 'id_student', 'date_submitted', 'is_banked', 'score']\n assessments  : ['code_module', 'code_presentation', 'id_assessment', 'assessment_type', 'date', 'weight']\n","output_type":"stream"}],"execution_count":6},{"id":"build-skill-map","cell_type":"code","source":"# ── Step 1: Build skill encoder from real vle.csv ──────────────────────────\n# Map each id_site → skill_id (integer) using activity_type as the skill label\n\n# Encode activity_type as integer skill_id\nvle_clean = vle[['id_site', 'activity_type']].drop_duplicates(subset='id_site').copy()\n\n# Assign a compact integer skill_id per unique id_site\nvle_clean = vle_clean.reset_index(drop=True)\nvle_clean['skill_id'] = vle_clean.index\n\nNUM_SKILLS = len(vle_clean)\nprint(f'Unique VLE resources (skills): {NUM_SKILLS}')\nprint(f'Activity type distribution:')\nprint(vle_clean['activity_type'].value_counts().to_string())\n\n# Save real skill_encoder — replaces the synthetic skill_encoder_v2.csv\nskill_encoder = vle_clean[['id_site', 'skill_id', 'activity_type']]\nskill_encoder.to_csv('skill_encoder_real.csv', index=False)\nprint(f'\\nSaved skill_encoder_real.csv ({len(skill_encoder)} rows)')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:57:38.638295Z","iopub.execute_input":"2026-04-16T23:57:38.638892Z","iopub.status.idle":"2026-04-16T23:57:38.667908Z","shell.execute_reply.started":"2026-04-16T23:57:38.638852Z","shell.execute_reply":"2026-04-16T23:57:38.666880Z"}},"outputs":[{"name":"stdout","text":"Unique VLE resources (skills): 6364\nActivity type distribution:\nactivity_type\nresource          2660\nsubpage           1055\noucontent          996\nurl                886\nforumng            194\nquiz               127\npage               102\noucollaborate       82\nquestionnaire       61\nouwiki              49\ndataplus            28\nexternalquiz        26\nhomepage            22\nglossary            21\nouelluminate        21\ndualpane            20\nrepeatactivity       5\nhtmlactivity         4\nsharedsubpage        3\nfolder               2\n\nSaved skill_encoder_real.csv (6364 rows)\n","output_type":"stream"}],"execution_count":7},{"id":"build-correctness","cell_type":"code","source":"# ── Step 2: Build interaction-level correctness (time-aware, no leakage) ──\n#\n# For each student × VLE interaction, find the nearest upcoming assessment\n# in the same (code_module, code_presentation) and use that score.\n# correct = 1 if score >= 50.\n#\n# This prevents leakage: the label for each interaction is only derived\n# from assessments that happen AFTER the interaction date.\n\n# 1. Join assessments metadata → get assessment date per id_assessment\nass_meta = assessments[['id_assessment', 'code_module', 'code_presentation', 'date']].copy()\nass_meta = ass_meta.rename(columns={'date': 'assessment_date'})\nass_meta['assessment_date'] = pd.to_numeric(ass_meta['assessment_date'], errors='coerce')\n\n# 2. Join student scores with assessment metadata\nstudent_ass_clean = student_ass.copy()\nstudent_ass_clean['score'] = pd.to_numeric(student_ass_clean['score'], errors='coerce')\nstudent_ass_clean = student_ass_clean.dropna(subset=['score'])\n\nass_with_meta = student_ass_clean.merge(ass_meta, on='id_assessment', how='inner')\nass_with_meta['correct'] = (ass_with_meta['score'] >= 50).astype(int)\n\nprint(f'Assessment events with metadata: {len(ass_with_meta):,}')\nprint(f'Correct rate in assessments: {ass_with_meta[\"correct\"].mean():.3f}')\nprint(ass_with_meta[['id_student', 'code_module', 'code_presentation',\n                      'assessment_date', 'score', 'correct']].head())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:57:38.669588Z","iopub.execute_input":"2026-04-16T23:57:38.670148Z","iopub.status.idle":"2026-04-16T23:57:38.742106Z","shell.execute_reply.started":"2026-04-16T23:57:38.670116Z","shell.execute_reply":"2026-04-16T23:57:38.741298Z"}},"outputs":[{"name":"stdout","text":"Assessment events with metadata: 173,739\nCorrect rate in assessments: 0.912\n   id_student code_module code_presentation  assessment_date  score  correct\n0       11391         AAA             2013J             19.0   78.0        1\n1       28400         AAA             2013J             19.0   70.0        1\n2       31604         AAA             2013J             19.0   72.0        1\n3       32885         AAA             2013J             19.0   69.0        1\n4       38053         AAA             2013J             19.0   79.0        1\n","output_type":"stream"}],"execution_count":8},{"id":"build-interactions","cell_type":"code","source":"# ── Step 3: Join VLE interactions with time-aware correctness labels ────────\n\n# Add module/presentation info to VLE resources\nvle_with_module = vle[['id_site', 'activity_type', 'code_module', 'code_presentation']].drop_duplicates('id_site')\n\n# Join student VLE with skill encoder and module info\nsvle = student_vle.merge(vle_with_module, on=['id_site', 'code_module', 'code_presentation'], how='inner')\nsvle = svle.rename(columns={'id_student': 'student_id'})\nsvle['date'] = pd.to_numeric(svle['date'], errors='coerce')\nsvle = svle.dropna(subset=['date'])\n\nprint(f'VLE events after module join: {len(svle):,}')\n\n# For each VLE event, find the nearest UPCOMING assessment in the same module/presentation\n# Strategy: sort-merge approach to avoid O(n²) cross join\n# Group assessments by (student, module, presentation), sort by date\nass_lookup = (\n    ass_with_meta[['id_student', 'code_module', 'code_presentation', 'assessment_date', 'correct']]\n    .rename(columns={'id_student': 'student_id'})\n    .sort_values(['student_id', 'code_module', 'code_presentation', 'assessment_date'])\n)\n\n# Merge VLE events with assessments on student+module+presentation\nmerged = svle.merge(\n    ass_lookup,\n    on=['student_id', 'code_module', 'code_presentation'],\n    how='inner'\n)\n\n# Keep only assessments that are UPCOMING (assessment_date >= vle date)\n# i.e. the interaction happens before or at the assessment\nmerged = merged[merged['assessment_date'] >= merged['date']]\n\n# For each VLE event, take the NEAREST upcoming assessment (min assessment_date)\nmerged['gap'] = merged['assessment_date'] - merged['date']\nnearest = (\n    merged.sort_values('gap')\n    .groupby(['student_id', 'id_site', 'date'], as_index=False)\n    .first()\n)\n\nprint(f'VLE events with valid correctness label: {len(nearest):,}')\nprint(f'Correct rate: {nearest[\"correct\"].mean():.3f}')\nprint(f'Label variance check — value_counts:')\nprint(nearest['correct'].value_counts())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:57:38.743262Z","iopub.execute_input":"2026-04-16T23:57:38.743618Z","iopub.status.idle":"2026-04-16T23:58:59.560327Z","shell.execute_reply.started":"2026-04-16T23:57:38.743588Z","shell.execute_reply":"2026-04-16T23:58:59.559550Z"}},"outputs":[{"name":"stdout","text":"VLE events after module join: 10,655,280\nVLE events with valid correctness label: 7,690,099\nCorrect rate: 0.932\nLabel variance check — value_counts:\ncorrect\n1    7170218\n0     519881\nName: count, dtype: int64\n","output_type":"stream"}],"execution_count":9},{"id":"save-interactions","cell_type":"code","source":"# ── Step 4: Build final interactions CSV ─────────────────────────────────\n\n# Assign compact skill_id from id_site\nskill_encoder = vle_clean[['id_site', 'skill_id', 'activity_type']]\nfinal = nearest.merge(skill_encoder[['id_site', 'skill_id']], on='id_site', how='inner')\n\ninteractions = (\n    final[['student_id', 'skill_id', 'correct', 'date']]\n    .rename(columns={'date': 'timestamp'})\n    .sort_values(['student_id', 'timestamp'])\n    .reset_index(drop=True)\n)\n\nprint(f'Final interactions  : {len(interactions):,}')\nprint(f'Unique students     : {interactions[\"student_id\"].nunique():,}')\nprint(f'Unique skills       : {interactions[\"skill_id\"].nunique():,}')\nprint(f'Correct rate        : {interactions[\"correct\"].mean():.3f}')\nprint(f'Label variance      : {interactions[\"correct\"].var():.4f}  (should be > 0.1)')\nprint()\nprint('Sample (first 5 rows):')\nprint(interactions.head())\n\n# Sanity check: AUC-1.0 guard\n# If a single student's correct values are all identical, leakage may still exist\nper_student_var = interactions.groupby('student_id')['correct'].var().fillna(0)\npct_varying = (per_student_var > 0).mean()\nprint(f'\\nStudents with label variation: {pct_varying:.1%}  (should be > 30%)')\nif pct_varying < 0.3:\n    print('⚠️  WARNING: low label variation — check join logic')\nelse:\n    print('✅ Label variation looks healthy')\n\ninteractions.to_csv('oulad_interactions.csv', index=False)\nskill_encoder.to_csv('skill_encoder_real.csv', index=False)\nprint(f'\\nSaved: oulad_interactions.csv')\nprint(f'Saved: skill_encoder_real.csv')\n\n# Sequence length stats\nseq_lens = interactions.groupby('student_id').size()\nprint(f'\\nSequence length stats:')\nprint(f'  mean   : {seq_lens.mean():.1f}')\nprint(f'  median : {seq_lens.median():.1f}')\nprint(f'  min    : {seq_lens.min()}')\nprint(f'  max    : {seq_lens.max()}')\nprint(f'  >= 5   : {(seq_lens >= 5).sum()} students (usable for training)')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:58:59.561319Z","iopub.execute_input":"2026-04-16T23:58:59.561598Z","iopub.status.idle":"2026-04-16T23:59:12.169712Z","shell.execute_reply.started":"2026-04-16T23:58:59.561571Z","shell.execute_reply":"2026-04-16T23:59:12.168827Z"}},"outputs":[{"name":"stdout","text":"Final interactions  : 7,690,099\nUnique students     : 23,295\nUnique skills       : 6,177\nCorrect rate        : 0.932\nLabel variance      : 0.0630  (should be > 0.1)\n\nSample (first 5 rows):\n   student_id  skill_id  correct  timestamp\n0        6516       352        1        -23\n1        6516       391        1        -23\n2        6516       247        1        -23\n3        6516       374        1        -23\n4        6516       388        1        -23\n\nStudents with label variation: 29.9%  (should be > 30%)\n⚠️  WARNING: low label