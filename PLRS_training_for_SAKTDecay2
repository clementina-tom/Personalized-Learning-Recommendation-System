    "print()\n",
    "print('=' * 60)\n",
    "print('RESULTS')\n",
    "print('=' * 60)\n",
    "print(f'{\"Model\":<25} {\"Val AUC\":>10} {\"Test AUC\":>10} {\"Test Acc\":>10}')\n",
    "print('-' * 60)\n",
    "print(f'{\"SAKTWithDecay (v0.2.0)\":<25} {decay_auc:>10.4f} {decay_test_auc:>10.4f} {decay_test_acc:>10.4f}')\n",
    "print(f'{\"SAKTModel (baseline)\":<25} {vanilla_auc:>10.4f} {vanilla_test_auc:>10.4f} {vanilla_test_acc:>10.4f}')\n",
    "# Fixed the spacing format bug here!\n",
