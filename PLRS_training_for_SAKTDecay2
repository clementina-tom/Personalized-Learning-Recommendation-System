    "    .reset_index(drop=True)\n",
    ")\n",
    "skill_df['skill_id'] = skill_df.index + 1  # 1-indexed, 0 reserved for padding\n",
    "\n",
    "NUM_SKILLS = len(skill_df) + 1  # +1 for padding\n",
    "print(f'Skill encoder: {len(skill_df)} unique (assessment_type × module) skills')\n",
    "print(skill_df.to_string())\n",
    "\n",
    "skill_df.to_csv('skill_encoder_real.csv', index=False)\n",
    "print(f'\\nSaved skill_encoder_real.csv')\n"
