    "# ── Step 1: Build skill encoder from assessment_type × code_module ──────────\n",
    "# Skill = what kind of assessment (TMA/CMA/Exam) in which module\n",
    "# This gives ~30-60 meaningful skill buckets with good coverage\n",
    "\n",
    "skill_df = (\n",
