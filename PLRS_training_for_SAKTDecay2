   "source": [
    "def train_model(model, sequences, num_skills, config, model_name='model'):\n",
    "    \"\"\"\n",
    "    Full training loop with early stopping.\n",
    "    Returns: (best_val_auc, checkpoint_path, history)\n",
    "    \"\"\"\n",
    "    np.random.seed(42)\n",
    "    idx    = np.random.permutation(len(sequences))\n",
    "    n_val  = max(1, int(len(sequences) * config['val_split']))\n",
    "    val_seq   = [sequences[i] for i in idx[:n_val]]\n",
    "    train_seq = [sequences[i] for i in idx[n_val:]]\n",
    "\n",
    "    print(f'  Train: {len(train_seq)} students | Val: {len(val_seq)} students')\n",
    "\n",
    "    max_seq_len = config.get('max_seq_len', 100)\n",
    "    train_ds = KTDataset(train_seq, max_seq_len, num_skills)\n",
    "    val_ds   = KTDataset(val_seq,   max_seq_len, num_skills)\n",
    "    train_loader = DataLoader(train_ds, batch_size=config['batch_size'],\n",
    "                              shuffle=True,  collate_fn=collate_fn, num_workers=2)\n",
    "    val_loader   = DataLoader(val_ds,   batch_size=config['batch_size'] * 2,\n",
    "                              shuffle=False, collate_fn=collate_fn, num_workers=2)\n",
    "\n",
    "    device    = torch.device(DEVICE)\n",
    "    model     = model.to(device)\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=config['lr'],\n",
    "                                 weight_decay=config['weight_decay'])\n",
    "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "        optimizer, mode='max', patience=2, factor=0.5\n",
    "    )\n",
    "    criterion = nn.BCEWithLogitsLoss()\n",
    "\n",
    "    # NaN gradient guard (for vanilla SAKT MHA padding edge case)\n",
    "    for p in model.parameters():\n",
    "        p.register_hook(lambda g: torch.nan_to_num(g, nan=0.0))\n",
    "\n",
    "    best_auc      = 0.0\n",
    "    patience_ctr  = 0\n",
    "    checkpoint    = f'{model_name}_best.pt'\n",
    "    history       = []\n",
    "\n",
    "    print(f'  Params: {sum(p.numel() for p in model.parameters()):,}')\n",
    "    print(f'  {\"Epoch\":>6} {\"Train Loss\":>11} {\"Val Loss\":>9} {\"Val AUC\":>9} {\"Val Acc\":>9} {\"Time\":>7}')\n",
    "    print('  ' + '-' * 56)\n",
    "\n",
    "    for epoch in range(1, config['epochs'] + 1):\n",
    "        t0 = time.time()\n",
    "\n",
    "        # ── Train ────────────────────────────────────────────────────\n",
    "        model.train()\n",
    "        total_loss = 0.0\n",
    "        for batch in train_loader:\n",
    "            interactions   = batch['interactions'].to(device)\n",
    "            target_skills  = batch['target_skills'].to(device)\n",
    "            target_correct = batch['target_correct'].to(device)\n",
    "            mask           = batch['mask'].to(device)\n",
    "\n",
    "            optimizer.zero_grad()\n",
    "            logits = model(interactions, target_skills, mask)\n",
    "            loss   = criterion(logits[mask], target_correct[mask])\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "            optimizer.step()\n",
    "            total_loss += loss.item()\n",
    "        train_loss = total_loss / max(len(train_loader), 1)\n",
    "\n",
    "        # ── Validate ─────────────────────────────────────────────────\n",
    "        model.eval()\n",
    "        val_loss_total = 0.0\n",
    "        all_probs, all_labels = [], []\n",
    "        with torch.no_grad():\n",
    "            for batch in val_loader:\n",
    "                interactions   = batch['interactions'].to(device)\n",
    "                target_skills  = batch['target_skills'].to(device)\n",
    "                target_correct = batch['target_correct'].to(device)\n",
    "                mask           = batch['mask'].to(device)\n",
    "\n",
    "                logits      = model(interactions, target_skills, mask)\n",
    "                real_logits = logits[mask]\n",
    "                real_labels = target_correct[mask]\n",
    "\n",
    "                val_loss_total += criterion(real_logits, real_labels).item()\n",
    "                all_probs.extend(torch.sigmoid(real_logits).cpu().numpy().tolist())\n",
    "                all_labels.extend(real_labels.cpu().numpy().tolist())\n",
    "\n",
    "        val_loss = val_loss_total / max(len(val_loader), 1)\n",
    "        probs_arr  = np.nan_to_num(np.array(all_probs),  nan=0.5)\n",
    "        labels_arr = np.nan_to_num(np.array(all_labels), nan=0.0)\n",
    "        val_auc = float(roc_auc_score(labels_arr, probs_arr)) \\\n",
    "                  if len(np.unique(labels_arr)) > 1 else 0.5\n",
    "        val_acc = float(((probs_arr >= 0.5) == labels_arr).mean())\n",
    "\n",
    "        scheduler.step(val_auc)\n",
    "        elapsed = time.time() - t0\n",
    "\n",
    "        history.append({'epoch': epoch, 'train_loss': train_loss,\n",
    "                        'val_loss': val_loss, 'val_auc': val_auc, 'val_acc': val_acc})\n",
    "\n",
    "        print(f'  {epoch:>6} {train_loss:>11.4f} {val_loss:>9.4f} '\n",
    "              f'{val_auc:>9.4f} {val_acc:>9.4f} {elapsed:>6.1f}s')\n",
    "\n",
    "        if val_auc > best_auc + 1e-4:\n",
    "            best_auc = val_auc\n",
    "            patience_ctr = 0\n",
    "            model.save(checkpoint, config={'num_skills': num_skills,\n",
    "                                           'embed_dim': config['embed_dim'],\n",
    "                                           'num_heads': config['num_heads'],\n",
    "                                           'dropout': config['dropout'],\n",
    "                                           'max_seq_len': max_seq_len,\n",
    "                                           'model_type': model_name})\n",
    "            print(f'         ✅ New best AUC: {best_auc:.4f} → {checkpoint}')\n",
    "        else:\n",
    "            patience_ctr += 1\n",
    "            if patience_ctr >= config['patience']:\n",
    "                print(f'\\n  Early stopping at epoch {epoch}')\n",
    "                break\n",
    "\n",
    "    print(f'\\n  Best val AUC: {best_auc:.4f}')\n",
    "    return best_auc, checkpoint, history\n",
    "\n",
    "\n",
    "print('Training loop defined ✅')"
   ]
