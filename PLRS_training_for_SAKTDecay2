eractions) + self.pos_embed(positions))\n\n        causal_mask     = torch.triu(torch.ones(L, L, device=x.device, dtype=torch.bool), diagonal=1)\n        key_padding_mask = ~mask\n\n        x_attn, _ = self.self_attn(x, x, x, attn_mask=causal_mask, key_padding_mask=key_padding_mask)\n        x_attn = torch.nan_to_num(x_attn, nan=0.0)\n        x = self.layer_norm1(x + x_attn)\n        x = self.layer_norm2(x + self.ffn(x))\n\n        out = self.output_layer(torch.cat([x, self.skill_embed(target_skills)], dim=-1)).squeeze(-1)\n        return out\n\n    def save(self, path, config=None):\n        torch.save({'state_dict': self.state_dict(), 'model_type': 'SAKTModel',\n                    'config': config or {'num_skills': self.num_skills, 'embed_dim': self.embed_dim,\n                                         'max_seq_len': self.max_seq_len}}, path)\n\nprint('SAKTModel defined ✅')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:59:12.170694Z","iopub.execute_input":"2026-04-16T23:59:12.170965Z","iopub.status.idle":"2026-04-16T23:59:12.182951Z","shell.execute_reply.started":"2026-04-16T23:59:12.170941Z","shell.execute_reply":"2026-04-16T23:59:12.182008Z"}},"outputs":[{"name":"stdout","text":"SAKTModel defined ✅\n","output_type":"stream"}],"execution_count":11},{"id":"model-sakt-decay","cell_type":"code","source":"# ── SAKTWithDecay (Ebbinghaus forgetting curve) ──────────────────────────────\n\nclass DecayAttention(nn.Module):\n    \"\"\"\n    Multi-head attention with Ebbinghaus forgetting curve decay.\n    Decay penalty: rate_h * log(1 + |i - j|) — learned per head.\n    \"\"\"\n    def __init__(self, embed_dim, num_heads, dropout=0.2, decay_init=1.0):\n        super().__init__()\n        self.embed_dim = embed_dim\n        self.num_heads = num_heads\n        self.head_dim  = embed_dim // num_heads\n        assert embed_dim % num_heads == 0\n\n        self.q_proj   = nn.Linear(embed_dim, embed_dim)\n        self.k_proj   = nn.Linear(embed_dim, embed_dim)\n        self.v_proj   = nn.Linear(embed_dim, embed_dim)\n        self.out_proj = nn.Linear(embed_dim, embed_dim)\n        self.dropout  = nn.Dropout(dropout)\n\n        # Learned decay rate per head — constrained positive via softplus\n        self.decay_logit = nn.Parameter(\n            torch.full((num_heads,), math.log(math.exp(decay_init) - 1))\n        )\n\n    def forward(self, x, causal_mask, key_padding_mask):\n        B, L, D = x.shape\n        H, Hd   = self.num_heads, self.head_dim\n\n        Q = self.q_proj(x).view(B, L, H, Hd).transpose(1, 2)\n        K = self.k_proj(x).view(B, L, H, Hd).transpose(1, 2)\n        V = self.v_proj(x).view(B, L, H, Hd).transpose(1, 2)\n\n        scores = torch.matmul(Q, K.transpose(-2, -1)) / math.sqrt(Hd)\n\n        # Ebbinghaus decay: penalise distant past interactions\n        positions = torch.arange(L, device=x.device)\n        dist = (positions.unsqueeze(0) - positions.unsqueeze(1)).abs().float()\n        decay_rate    = F.softplus(self.decay_logit)           # (H,)\n        decay_penalty = decay_rate.view(H, 1, 1) * torch.log1p(dist).unsqueeze(0)\n        scores = scores - decay_penalty.unsqueeze(0)\n\n        scores = scores.masked_fill(causal_mask.unsqueeze(0).unsqueeze(0), -1e9)\n        if key_padding_mask is not None:\n            scores = scores.masked_fill(key_padding_mask.unsqueeze(1).unsqueeze(2), -1e9)\n\n        attn = self.dropout(F.softmax(scores, dim=-1))\n        out  = torch.matmul(attn, V).transpose(1, 2).contiguous().view(B, L, D)\n        return self.out_proj(out)\n\n\nclass SAKTWithDecay(nn.Module):\n    \"\"\"SAKT + Ebbinghaus Forgetting Curve Decay — drop-in upgrade.\"\"\"\n\n    def __init__(self, num_skills, embed_dim=64, num_heads=8, dropout=0.2,\n                 max_seq_len=100, decay_init=1.0):\n        super().__init__()\n        self.num_skills  = num_skills\n        self.embed_dim   = embed_dim\n        self.max_seq_len = max_seq_len\n\n        self.interaction_embed = nn.Embedding(2 * num_skills + 2, embed_dim, padding_idx=0)\n        self.pos_embed         = nn.Embedding(max_seq_len, embed_dim)\n        self.decay_attn        = DecayAttention(embed_dim, num_heads, dropout, decay_init)\n        self.layer_norm1 = nn.LayerNorm(embed_dim)\n        self.layer_norm2 = nn.LayerNorm(embed_dim)\n        self.ffn = nn.Sequential(\n            nn.Linear(embed_dim, embed_dim * 2), nn.ReLU(),\n            nn.Dropout(dropout), nn.Linear(embed_dim * 2, embed_dim),\n        )\n        self.skill_embed  = nn.Embedding(num_skills + 1, embed_dim, padding_idx=0)\n        self.output_layer = nn.Linear(embed_dim * 2, 1)\n        self.dropout      = nn.Dropout(dropout)\n\n    def forward(self, interactions, target_skills, mask):\n        B, L = interactions.shape\n        positions = torch.arange(L, device=interactions.device).unsqueeze(0)\n        x = self.dropout(self.interaction_embed(interactions) + self.pos_embed(positions))\n\n        causal_mask      = torch.triu(torch.ones(L, L, device=x.device, dtype=torch.bool), diagonal=1)\n        key_padding_mask = ~mask\n\n        x = self.layer_norm1(x + self.decay_attn(x, causal_mask, key_padding_mask))\n        x = self.layer_norm2(x + self.ffn(x))\n        out = self.output_layer(torch.cat([x, self.skill_embed(target_skills)], dim=-1)).squeeze(-1)\n        return out\n\n    def save(self, path, config=None):\n        torch.save({\n            'state_dict': self.state_dict(),\n            'model_type': 'SAKTWithDecay',\n            'config': config or {\n                'num_skills':  self.num_skills,\n                'embed_dim':   self.embed_dim,\n                'num_heads':   self.decay_attn.num_heads,\n                'max_seq_len': self.max_seq_len,\n                'model_type':  'SAKTWithDecay',\n            }\n        }, path)\n\n    @classmethod\n    def load(cls, path, device='cpu'):\n        payload = torch.load(path, map_location=device, weights_only=False)\n        cfg = payload['config']\n        model = cls(num_skills=cfg['num_skills'], embed_dim=cfg.get('embed_dim', 64),\n                    num_heads=cfg.get('num_heads', 8), dropout=cfg.get('dropout', 0.2),\n                    max_seq_len=cfg.get('max_seq_len', 100), decay_init=cfg.get('decay_init', 1.0))\n        model.load_state_dict(payload['state_dict'])\n        return model.to(device).eval()\n\nprint('SAKTWithDecay defined ✅')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:59:12.184251Z","iopub.execute_input":"2026-04-16T23:59:12.184565Z","iopub.status.idle":"2026-04-16T23:59:12.206846Z","shell.execute_reply.started":"2026-04-16T23:59:12.184538Z","shell.execute_reply":"2026-04-16T23:59:12.206049Z"}},"outputs":[{"name":"stdout","text":"SAKTWithDecay defined ✅\n","output_type":"stream"}],"execution_count":12},{"id":"sec5","cell_type":"markdown","source":"## 5. Dataset & Training Infrastructure","metadata":{}},{"id":"dataset","cell_type":"code","source":"from torch.utils.data import Dataset, DataLoader\nfrom sklearn.metrics import roc_auc_score\nimport time\n\n\nclass KTDataset(Dataset):\n    def __init__(self, sequences, max_seq_len=100, n_skills=5736):\n        self.max_seq_len = max_seq_len\n        self.n_skills    = n_skills\n        self.samples     = []\n        for skill_seq, correct_seq in sequences:\n            for start in range(0, max(1, len(skill_seq) - 1), max_seq_len // 2):\n                s = skill_seq[start : start + max_seq_len + 1]\n                c = correct_seq[start : start + max_seq_len + 1]\n                if len(s) >= 2:\n                    self.samples.append((s, c))\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        skill_seq, correct_seq = self.samples[idx]\n        if len(skill_seq) > self.max_seq_len + 1:\n            skill_seq   = skill_seq[-self.max_seq_len - 1:]\n            correct_seq = correct_seq[-self.max_seq_len - 1:]\n\n        interactions   = [s + c * self.n_skills + 1 for s, c in zip(skill_seq[:-1], correct_seq[:-1])]\n        target_skills  = skill_seq[1:]\n        target_correct = correct_seq[1:]\n        seq_len = len(interactions)\n        pad_len = self.max_seq_len - seq_len\n\n        return {\n            'interactions':   torch.LongTensor([0] * pad_len + interactions),\n            'target_skills':  torch.LongTensor([0] * pad_len + target_skills),\n            'target_correct': torch.FloatTensor([0] * pad_len + target_correct),\n            'mask':           torch.BoolTensor([False] * pad_len + [True] * seq_len),\n        }\n\n\ndef collate_fn(batch):\n    return {k: torch.stack([b[k] for b in batch]) for k in batch[0]}\n\n\ndef load_sequences(csv_path, min_seq_len=5):\n    df = pd.read_csv(csv_path).sort_values(['student_id', 'timestamp'])\n    sequences = []\n    for _, grp in df.groupby('student_id'):\n        skills   = grp['skill_id'].astype(int).tolist()\n        corrects = grp['correct'].astype(int).tolist()\n        if len(skills) >= min_seq_len:\n            sequences.append((skills, corrects))\n    print(f'Loaded {len(sequences)} student sequences')\n    return sequences\n\n\nprint('Dataset utilities defined ✅')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-16T23:59:12.210533Z","iopub.execute_input":"2026-04-16T23:59:12.210888Z","iopub.status.idle":"2026-04-16T23:59:13.392118Z","shell.execute_reply.started":"2026-04-16T23:59:12.210859Z","shell.execute_reply":"2026-04-16T23:59:13.391260Z"}},"outputs":[{"name":"stdout","text":"Dataset utilities defined ✅\n","output_type":"stream"}],"execution_count":13},{"id":"train-fn","cell_type":"code","source":"def train_model(model, sequences, num_skills, config, model_name='model'):\n    \"\"\"\n    Full training loop with early stopping.\n    Returns: (best_val_auc, checkpoint_path, history)\n    \"\"\"\n    np.random.seed(42)\n    idx    = np.random.permutation(len(sequences))\n    n_val  = max(1, int(len(sequences) * config['val_split']))\n    val_seq   = [sequences[i] for i in idx[:n_val]]\n    train_seq = [sequences[i] for i in idx[n_val:]]\n\n    print(f'  Train: {len(train_seq)} students | Val: {len(val_seq)} students')\n\n    max_seq_len = config.get('max_seq_len', 100)\n    train_ds = KTDataset(train_seq, max_seq_len, num_skills)\n    val_ds   = KTDataset(val_seq,   max_seq_len, num_skills)\n    train_loader = DataLoader(train_ds, batch_size=config['batch_size'],\n                              shuffle=True,  collate_fn=collate_fn, num_workers=2)\n    val_loader   = DataLoader(val_ds,   batch_size=config['batch_size'] * 2,\n                              shuffle=False, collate_fn=collate_fn, num_workers=2)\n\n    device    = torch.device(DEVICE)\n    model     = model.to(device)\n    optimizer = torch.optim.Adam(model.parameters(), lr=config['lr'],\n                                 weight_decay=config['weight_decay'])\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode='max', patience=2, factor=0.5\n    )\n    criterion = nn.BCEWithLogitsLoss()\n\n    # NaN gradient guard (for vanilla SAKT MHA padding edge case)\n    for p in model.parameters():\n        p.register_hook(lambda g: torch.nan_to_num(g, nan=0.0))\n\n    best_auc      = 0.0\n    patience_ctr  = 0\n    checkpoint    = f'{model_name}_best.pt'\n    history       = []\n\n    print(f'  Params: {sum(p.numel() for p in model.parameters()):,}')\n    print(f'  {\"Epoch\":>6} {\"Train Loss\":>11} {\"Val Loss\":>9} {\"Val AUC\":>9} {\"Val Acc\":>9} {\"Time\":>7}')\n    print('  ' + '-' * 56)\n\n    for epoch in range(1, config['epochs'] + 1):\n        t0 = time.time()\n\n        # ── Train ────────────────────────────────────────────────────\n        model.train()\n        total_loss = 0.0\n        for batch in train_loader:\n            interactions   = batch['interactions'].to(device)\n            target_skills  = batch['target_skills'].to(device)\n            target_correct = batch['target_correct'].to(device)\n            mask           = batch['mask'].to(device)\n\n            optimizer.zero_grad()\n            logits = model(interactions, target_skills, mask)\n            loss   = criterion(logits[mask], target_correct[mask])\n            loss.backward()\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            optimizer.step()\n            total_loss += loss.item()\n        train_loss = total_loss / max(len(train_loader), 1)\n\n        # ── Validate ─────────────────────────────────────────────────\n        model.eval()\n        val_loss_total = 0.0\n        all_probs, all_labels = [], []\n        with torch.no_grad():\n            for batch in val_loader:\n                interactions   = batch['interactions'].to(device)\n                target_skills  = batch['target_skills'].to(device)\n                target_correct = batch['target_correct'].to(device)\n                mask           = batch['mask'].to(device)\n\n                logits      = model(interactions, target_skills, mask)\n                real_logits = logits[mask]\n                real_labels = target_correct[mask]\n\n                val_loss_total += criterion(real_logits, real_labels).item()\n                all_probs.extend(torch.sigmoid(real_logits).cpu().numpy().tolist())\n                all_labels.extend(real_labels.cpu().numpy().tolist())\n\n        val_loss = val_loss_total / max(len(val_loader), 1)\n        probs_arr  = np.nan_to_num(np.array(all_probs),  nan=0.5)\n        labels_arr = np.nan_to_num(np.array(all_labels), nan=0.0)\n        val_auc = float(roc_auc_score(labels_arr, probs_arr)) \\\n                  if len(np.unique(labels_arr)) > 1 else 0.5\n        val_acc = float(((probs_arr >= 0.5) == labels_arr).mean())\n\n        scheduler.step(val_auc)\n        elapsed = time.time() - t0\n\n        history.append({'epoch': epoch, 'train_loss': train_loss,\n                        'val_loss': val_loss, 'val_auc': val_auc, 'val_acc': val_acc})\n\n        print(f'  {epoch