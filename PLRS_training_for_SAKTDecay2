    "def evaluate_on_test(checkpoint_path, model_class, test_sequences, num_skills, max_seq_len=100):\n",
    "    \"\"\"Run inference on held-out test set and return AUC + Acc.\"\"\"\n",
    "    if model_class == SAKTWithDecay:\n",
    "        model = SAKTWithDecay.load(checkpoint_path, device=DEVICE)\n",
    "    else:\n",
    "        payload = torch.load(checkpoint_path, map_location=DEVICE, weights_only=False)\n",
    "        cfg     = payload['config']\n",
    "        model   = SAKTModel(num_skills=cfg['num_skills'], embed_dim=cfg.get('embed_dim', 64),\n",
    "                            num_heads=cfg.get('num_heads', 8), dropout=cfg.get('dropout', 0.2),\n",
    "                            max_seq_len=cfg.get('max_seq_len', 100))\n",
    "        model.load_state_dict(payload['state_dict'])\n",
    "        model = model.to(DEVICE).eval()\n",
    "\n",
    "    test_ds     = KTDataset(test_sequences, max_seq_len, num_skills)\n",
    "    test_loader = DataLoader(test_ds, batch_size=128, shuffle=False,\n",
    "                             collate_fn=collate_fn, num_workers=2)\n",
    "\n",
    "    all_probs, all_labels = [], []\n",
    "    with torch.no_grad():\n",
    "        for batch in test_loader:\n",
    "            ints   = batch['interactions'].to(DEVICE)\n",
    "            tskill = batch['target_skills'].to(DEVICE)\n",
    "            tcorr  = batch['target_correct'].to(DEVICE)\n",
    "            mask   = batch['mask'].to(DEVICE)\n",
    "            logits = model(ints, tskill, mask)\n",
    "            all_probs.extend(torch.sigmoid(logits[mask]).cpu().numpy().tolist())\n",
    "            all_labels.extend(tcorr[mask].cpu().numpy().tolist())\n",
    "\n",
    "    probs  = np.nan_to_num(np.array(all_probs), nan=0.5)\n",
    "    labels = np.nan_to_num(np.array(all_labels), nan=0.0)\n",
    "    auc = float(roc_auc_score(labels, probs)) if len(np.unique(labels)) > 1 else 0.5\n",
    "    acc = float(((probs >= 0.5) == labels).mean())\n",
    "    return auc, acc\n",
    "\n",
    "\n",
    "print('Evaluating on held-out test set...')\n",
    "decay_test_auc,   decay_test_acc   = evaluate_on_test(decay_ckpt,   SAKTWithDecay, test_seq, NUM_SKILLS)\n",
    "vanilla_test_auc, vanilla_test_acc = evaluate_on_test(vanilla_ckpt, SAKTModel,     test_seq, NUM_SKILLS)\n",
    "\n",
    "print()\n",
    "print('=' * 60)\n",
    "print('RESULTS')\n",
    "print('=' * 60)\n",
    "print(f'{\"Model\":<25} {\"Val AUC\":>10} {\"Test AUC\":>10} {\"Test Acc\":>10}')\n",
    "print('-' * 60)\n",
    "print(f'{\"SAKTWithDecay (v0.2.0)\":<25} {decay_auc:>10.4f} {decay_test_auc:>10.4f} {decay_test_acc:>10.4f}')\n",
    "print(f'{\"SAKTModel (baseline)\":<25} {vanilla_auc:>10.4f} {vanilla_test_auc:>10.4f} {vanilla_test_acc:>10.4f}')\n",
    "print(f'{\"FYP baseline\":<25} {\"0.7692\":>10} {\"—\":>10} {\"—\":>10}')\n",
    "print('=' * 60)\n",
    "\n",
    "delta = decay_test_auc - vanilla_test_auc\n",
    "target_met = decay_test_auc >= 0.785\n",
    "print(f'\\nDecay improvement over vanilla: {delta:+.4f}')\n",
    "print(f'Target AUC ≥ 0.785: {\"✅ MET\" if target_met else \"❌ not yet — see tuning tips below\"}')"
   ]
