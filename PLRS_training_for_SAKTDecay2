    "from torch.utils.data import Dataset, DataLoader\n",
    "from sklearn.metrics import roc_auc_score\n",
    "import time\n",
    "\n",
    "\n",
    "class KTDataset(Dataset):\n",
    "    def __init__(self, sequences, max_seq_len=100, n_skills=5736):\n",
    "        self.max_seq_len = max_seq_len\n",
    "        self.n_skills    = n_skills\n",
    "        self.samples     = []\n",
    "        for skill_seq, correct_seq in sequences:\n",
    "            for start in range(0, max(1, len(skill_seq) - 1), max_seq_len // 2):\n",
    "                s = skill_seq[start : start + max_seq_len + 1]\n",
    "                c = correct_seq[start : start + max_seq_len + 1]\n",
    "                if len(s) >= 2:\n",
    "                    self.samples.append((s, c))\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.samples)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        skill_seq, correct_seq = self.samples[idx]\n",
    "        if len(skill_seq) > self.max_seq_len + 1:\n",
    "            skill_seq   = skill_seq[-self.max_seq_len - 1:]\n",
    "            correct_seq = correct_seq[-self.max_seq_len - 1:]\n",
    "\n",
    "        interactions   = [s + c * self.n_skills + 1 for s, c in zip(skill_seq[:-1], correct_seq[:-1])]\n",
    "        target_skills  = skill_seq[1:]\n",
    "        target_correct = correct_seq[1:]\n",
    "        seq_len = len(interactions)\n",
    "        pad_len = self.max_seq_len - seq_len\n",
    "\n",
    "        return {\n",
    "            'interactions':   torch.LongTensor([0] * pad_len + interactions),\n",
    "            'target_skills':  torch.LongTensor([0] * pad_len + target_skills),\n",
    "            'target_correct': torch.FloatTensor([0] * pad_len + target_correct),\n",
    "            'mask':           torch.BoolTensor([False] * pad_len + [True] * seq_len),\n",
    "        }\n",
    "\n",
    "\n",
    "def collate_fn(batch):\n",
    "    return {k: torch.stack([b[k] for b in batch]) for k in batch[0]}\n",
    "\n",
    "\n",
    "def load_sequences(csv_path, min_seq_len=5):\n",
    "    df = pd.read_csv(csv_path).sort_values(['student_id', 'timestamp'])\n",
    "    sequences = []\n",
    "    for _, grp in df.groupby('student_id'):\n",
    "        skills   = grp['skill_id'].astype(int).tolist()\n",
    "        corrects = grp['correct'].astype(int).tolist()\n",
    "        if len(skills) >= min_seq_len:\n",
    "            sequences.append((skills, corrects))\n",
    "    print(f'Loaded {len(sequences)} student sequences')\n",
    "    return sequences\n",
    "\n",
    "\n",
    "print('Dataset utilities defined ✅')"
   ]
